    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "papaparse": "5.5.3",
    "pg": "8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.1",
    "@types/papaparse": "5.5.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
