# Postgres connection string (Supabase transaction pooler, Neon, or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eightgrid

# Random secret for session encryption: `openssl rand -base64 32`
AUTH_SECRET=

# Comma-separated email domains allowed to sign up / sign in (empty = anyone)
ALLOWED_EMAIL_DOMAINS=8limbsinc.net

# Optional Google SSO (https://console.cloud.google.com/apis/credentials)
# Redirect URI: https://<your-site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Needed when not on Vercel (Netlify sets this via netlify.toml)
AUTH_TRUST_HOST=true

# Emails are not verified for password sign-ups. Once Google SSO is configured,
# set this to true so everyone signs in with their company Google account.
DISABLE_PASSWORD_SIGNUP=false

# If your DB provider's TLS chain isn't trusted by Node (some Supabase setups), set to no-verify
DATABASE_SSL=
# Optional direct/session connection used only for migrations (Supabase: port 5432)
MIGRATION_DATABASE_URL=
